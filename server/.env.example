# ---------- ECN server configuration ----------
# Copy this file to ".env" and fill in the values.

# MongoDB Atlas connection string (Atlas -> Connect -> Drivers). URL-encode special chars in the password.
MONGODB_URI=mongodb+srv://monish10444_db_user:lBYOZwsi0iqrEpvV@cluster0.dskfirk.mongodb.net/

# Long random string (>= 32 chars). Used to sign short-lived socket tickets.
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=6oQN4js-YfPX3VgZQL1EMLpd9lX9dx7JXZRXS-VJfNelplDFSg9ZmlibbxNEGxJ4

PORT=5000
NODE_ENV=development

# Comma-separated list of browser origins allowed to use the API/sockets (no trailing slash).
# Local dev:  http://localhost:5173
# Production: https://your-app.vercel.app
CLIENT_ORIGIN=http://localhost:5173

# How many reverse-proxy hops sit in front of this server (Render/Railway/Fly = 1). Used for client IPs.
TRUST_PROXY=1

# Redirect plain HTTP to HTTPS (needs a proxy that sets X-Forwarded-Proto). Recommended in production.
FORCE_HTTPS=false

# Only set to true if browsers call this API DIRECTLY from a different site (SameSite=None cookies).
# The recommended Vercel setup proxies /api through Vercel, so leave this false.
CROSS_SITE=false

# Serve ../client/dist from this server too (single-service deployment). Set false to disable.
SERVE_CLIENT=true

# Optional native HTTPS (otherwise let your host terminate TLS):
# TLS_KEY_PATH=./certs/key.pem
# TLS_CERT_PATH=./certs/cert.pem
