# Client build-time settings (Vite). Copy to ".env.local" for local overrides.

# Base URL of the API.  Leave EMPTY to use same-origin "/api"
#   - local dev: Vite proxies /api -> http://localhost:5000
#   - Vercel:    vercel.json rewrites /api -> your backend (cookies stay first-party; recommended)
# Only set this if the browser must call the backend directly (then also set CROSS_SITE=true on the server).
VITE_API_URL=

# Socket.IO endpoint. Vercel cannot proxy WebSockets, so in production point this at your backend,
# e.g. https://ecn-server.onrender.com . Leave EMPTY for local dev (same origin via the Vite proxy).
VITE_SOCKET_URL=
